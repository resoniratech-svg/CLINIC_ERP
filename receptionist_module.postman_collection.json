{
  "info": {
    "_postman_id": "c1f2e3d4-5678-90ab-cdef-1234567890ab",
    "name": "Receptionist Module — Hospital ERP API",
    "description": "Complete Postman collection for the Receptionist Module including authentication, dashboard, patient search, registration, enquiries, referrals, doctor assignment, appointments, consultation billing, check-in, renewals, due payments, CRM calls, and callback tasks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Auth",
      "item": [
        {
          "name": "Receptionist Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data.token) {",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"rita_rec\",\n  \"password\": \"Password@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "1. Dashboard",
      "item": [
        {
          "name": "Get Receptionist Dashboard",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/receptionist/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["receptionist", "dashboard"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Patient Search & Overview",
      "item": [
        {
          "name": "Search Patient by Mobile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/receptionist/patients/search?mobile=9876543210",
              "host": ["{{baseUrl}}"],
              "path": ["receptionist", "patients", "search"],
              "query": [
                { "key": "mobile", "value": "9876543210" }
              ]
            }
          }
        },
        {
          "name": "Get Patient Overview",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
