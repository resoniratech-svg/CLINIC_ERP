        ],
        "url": {
          "raw": "{{base_url}}/api/v1/doctor/patients?search=Ravi",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "doctor", "patients"],
          "query": [{ "key": "search", "value": "Ravi" }]
        }
      }
    },
    {
      "name": "6. Patient Overview",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
