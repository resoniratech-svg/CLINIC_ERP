{
  "info": {
    "_postman_id": "doctor-module-collection-001",
    "name": "Doctor Module — Hospital ERP Backend",
    "description": "Complete ready-to-import Postman Collection for the Doctor Module backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Doctor Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.success && jsonData.data && jsonData.data.token) {",
              "    pm.collectionVariables.set(\"token\", jsonData.data.token);",
              "    console.log('Doctor Token Auto-Populated');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"dr_smith\",\n  \"password\": \"Password@123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/auth/login",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "auth", "login"]
        }
      }
    },
    {
      "name": "2. Doctor Dashboard",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/doctor/dashboard",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "doctor", "dashboard"]
        }
      }
    },
    {
      "name": "3. Today's Appointments",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/doctor/appointments/today",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "doctor", "appointments", "today"]
        }
      }
    },
    {
      "name": "4. Patient Queue",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/doctor/queue",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "doctor", "queue"]
